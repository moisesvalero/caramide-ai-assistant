# Google Gemini API (Google AI Studio - Free Tier)
# Modelos disponibles en Free Tier:
# - gemini-3.5-flash-lite (Ultrarrápido, optimizado para mínima latencia)
# - gemini-3.8-flash (Máximo razonamiento e inteligencia de la serie Flash)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
